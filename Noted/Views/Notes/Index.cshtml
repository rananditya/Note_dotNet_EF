@model IEnumerable<Noted.Models.Notes>

@{
    ViewData["Title"] = "My Notes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">My Notes</h1>
            <small class="text-muted">@Model.Count() catatan tersimpan</small>
        </div>

        @if (Model.Any())
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> New Note
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 60vh;">
            <i class="bi bi-journal-text" style="font-size: 3rem; color: #ccc;"></i>
            <p class="text-muted mt-3 mb-3">Belum ada catatan nih, yuk bikin yang pertama.</p>
            <a asp-action="Create" class="btn btn-primary">+ New Note</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var note in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm note-card">

                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@note.Title</h5>
                                <span class="badge bg-secondary">@note.Category</span>
                            </div>

                            <p class="card-text text-muted flex-grow-1 line-clamp-3">
                                @note.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i> @note.CreatedDate.ToString("dd MMM yyyy")
                                </small>

                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-outline-secondary btn-icon">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-secondary btn-icon"
                                            data-bs-toggle="modal"
                                            data-bs-target="#noteDetailModal"
                                            data-title="@note.Title"
                                            data-description="@note.Description"
                                            data-content="@note.Content"
                                            data-category="@note.Category"
                                            data-created="@note.CreatedDate.ToString("dd MMM yyyy")"
                                            data-updated="@note.UpdateDate.ToString("dd MMM yyyy, HH:mm")">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <form asp-action="Delete" asp-route-id="@note.Id" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Yakin mau hapus catatan ini?');">
                                        <button type="submit" class="btn btn-outline-danger btn-icon">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .note-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .note-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1) !important;
        }

    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
    }

        .btn-icon:focus,
        .btn-icon:focus-visible {
            box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.15);
        }




    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<!-- Note Detail Modal (reused for all notes) -->
<div class="modal fade" id="noteDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalNoteTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <span class="badge bg-secondary mb-3" id="modalNoteCategory"></span>
                <p class="text-muted" id="modalNoteDescription"></p>
                <hr />
                <p id="modalNoteContent" style="white-space: pre-wrap;"></p>
            </div>

            <div class="modal-footer justify-content-between">
                <small class="text-muted" id="modalNoteDates"></small>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const noteDetailModal = document.getElementById('noteDetailModal');

        noteDetailModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            document.getElementById('modalNoteTitle').textContent = button.getAttribute('data-title');
            document.getElementById('modalNoteCategory').textContent = button.getAttribute('data-category') || 'Uncategorized';
            document.getElementById('modalNoteDescription').textContent = button.getAttribute('data-description');
            document.getElementById('modalNoteContent').textContent = button.getAttribute('data-content');

            const created = button.getAttribute('data-created');
            const updated = button.getAttribute('data-updated');
            document.getElementById('modalNoteDates').textContent = `Created: ${created} · Updated: ${updated}`;
        });
    </script>
}